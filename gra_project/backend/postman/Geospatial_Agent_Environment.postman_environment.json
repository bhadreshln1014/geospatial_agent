      "value": "{{base_url}}/agent_app/get_output_files/",
      "type": "default",
      "enabled": true
    },
    {
      "key": "geoserver_url",
      "value": "http://localhost:8080/geoserver",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}

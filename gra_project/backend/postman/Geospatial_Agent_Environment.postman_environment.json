{
  "id": "geospatial-agent-env",
  "name": "Geospatial Agent Environment",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "default",
      "enabled": true
    },
    {
      "key": "agent_endpoint",
      "value": "{{base_url}}/agent_app/stream_query_agent/",
      "type": "default",
      "enabled": true
    },
    {

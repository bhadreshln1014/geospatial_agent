{
  "info": {
    "name": "Geospatial Reasoning Agent API",
    "description": "Test collection for the Geospatial Reasoning Agent with live data sources",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "agent_endpoint",
      "value": "{{base_url}}/agent_app/stream_query_agent/",
      "type": "string"
    },
    {
      "key": "files_endpoint",
      "value": "{{base_url}}/agent_app/get_output_files/",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Simple Data Acquisition - Schools",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Set timestamp for tracking",
              "pm.globals.set('test_timestamp', new Date().toISOString());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test basic response",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type is text/event-stream', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
              "});",
              "",
              "// Parse SSE events",
              "const responseText = pm.response.text();",
              "const events = responseText.split('\\n\\n').filter(line => line.startsWith('data: '));",
              "",
              "pm.test('Received streaming events', function () {",
              "    pm.expect(events.length).to.be.greaterThan(0);",
              "});",
              "",
              "// Check that only simple data acquisition was used (no buffer or MCA)",
              "let hasUnnecessaryAnalysis = false;",
              "events.forEach(event => {",
              "    try {",
              "        const data = JSON.parse(event.replace('data: ', ''));",
              "        if (data.message && typeof data.message === 'string') {",
              "            if (data.message.includes('PerformBufferAnalysis') || data.message.includes('PerformMultiCriteriaAnalysis')) {",
              "                hasUnnecessaryAnalysis = true;",
              "            }",
              "        }",
              "    } catch (e) {",
              "        // Skip malformed events",
              "    }",
              "});",
              "",
              "pm.test('No unnecessary analysis performed for simple query', function () {",
              "    pm.expect(hasUnnecessaryAnalysis).to.be.false;",
              "});",
              "",
              "// Check for completion event",
              "let completionEvent = null;",
              "events.forEach(event => {",
              "    try {",
              "        const data = JSON.parse(event.replace('data: ', ''));",
              "        if (data.type === 'complete') {",
              "            completionEvent = data;",
              "        }",
              "    } catch (e) {",
              "        // Skip malformed events",
              "    }",
              "});",
              "",
              "pm.test('Analysis completed successfully', function () {",
              "    pm.expect(completionEvent).to.not.be.null;",
              "    pm.expect(completionEvent.message).to.include('complete');",
              "});",
              "",
              "if (completionEvent) {",
              "    pm.test('Final map result is present', function () {",
              "        pm.expect(completionEvent.final_map_result).to.exist;",
              "    });",
              "    ",
              "    pm.test('Vector file type detected', function () {",
              "        const mapResult = JSON.parse(completionEvent.final_map_result);",
              "        pm.expect(mapResult.file_type).to.equal('vector');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"find all schools in Chennai\"\n}"
        },
        "url": {
          "raw": "{{agent_endpoint}}",
          "host": ["{{agent_endpoint}}"]
        },
        "description": "Test simple data acquisition without unnecessary analysis"
      }
    },
